---
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import { SITE, url, pilotHref } from '../site.config';

interface Props { title?: string; description?: string }
const { title = `${SITE.name} | ${SITE.tagline}`, description = SITE.description } = Astro.props;
const ogImage = new URL(url('og.png'), Astro.site).href;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const nav = [
  { label: 'Product', href: '#product' },
  { label: 'How it works', href: '#how' },
  { label: 'Economics', href: '#economics' },
  { label: 'Compare', href: '#compare' },
  { label: 'Docs', href: url('docs/') },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <meta name="theme-color" content="#080b10" />
    <noscript><style>.reveal { opacity: 1 !important; transform: none !important; }</style></noscript>
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body>
    <a class="skip sr-only" href="#main">Skip to content</a>
    <header class="nav" data-nav>
      <div class="container nav-inner">
        <a href={url()} class="brand" aria-label="Tunyx home"><Logo /></a>
        <nav class="links" aria-label="Main">
          {nav.map((n) => <a href={n.href}>{n.label}</a>)}
        </nav>
        <div class="actions">
          <a class="gh" href={SITE.github} aria-label="GitHub" rel="noopener">
            <svg width="18" height="18" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
          </a>
          <a class="btn btn-ghost btn-sm hide-sm" href={url('docs/getting-started/quickstart/')}>Quickstart</a>
          <a class="btn btn-primary btn-sm" href={pilotHref}>Request a pilot</a>
          <button class="menu" aria-label="Open menu" aria-expanded="false" data-menu>
            <span></span><span></span>
          </button>
        </div>
      </div>
      <div class="drawer" data-drawer hidden>
        {nav.map((n) => <a href={n.href}>{n.label}</a>)}
        <a href={url('docs/getting-started/quickstart/')}>Quickstart</a>
        <a href={SITE.github}>GitHub</a>
      </div>
    </header>

    <main id="main"><slot /></main>

    <footer class="footer">
      <div class="container foot-grid">
        <div class="foot-brand">
          <Logo />
          <p class="muted">Inference that tunes itself. Fast, validated endpoints on your own hardware.</p>
          <span class="chip"><span class="dot"></span>{SITE.status}</span>
        </div>
        <div>
          <h4>Product</h4>
          <a href="#product">Features</a>
          <a href="#how">How it works</a>
          <a href="#economics">Economics</a>
          <a href="#compare">Compare</a>
        </div>
        <div>
          <h4>Docs</h4>
          <a href={url('docs/getting-started/quickstart/')}>Quickstart</a>
          <a href={url('docs/concepts/how-it-works/')}>Concepts</a>
          <a href={url('docs/guides/apis/')}>API guide</a>
          <a href={url('docs/reference/cli/')}>CLI reference</a>
        </div>
        <div>
          <h4>Company</h4>
          <a href={pilotHref}>Request a pilot</a>
          <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
          <a href={SITE.github}>GitHub</a>
        </div>
      </div>
      <div class="container foot-base">
        <span>© {new Date().getFullYear()} Tunyx</span>
        <span class="muted">Built for teams who run their own models.</span>
      </div>
    </footer>

    <script>
      // Nav: solid background once scrolled; mobile drawer.
      const nav = document.querySelector<HTMLElement>('[data-nav]')!;
      const onScroll = () => nav.classList.toggle('scrolled', window.scrollY > 8);
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });
      const btn = document.querySelector<HTMLButtonElement>('[data-menu]')!;
      const drawer = document.querySelector<HTMLElement>('[data-drawer]')!;
      btn.addEventListener('click', () => {
        const open = btn.getAttribute('aria-expanded') !== 'true';
        btn.setAttribute('aria-expanded', String(open));
        drawer.hidden = !open;
      });
      drawer.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).tagName === 'A') { drawer.hidden = true; btn.setAttribute('aria-expanded', 'false'); }
      });

      // Reveal sections as they enter the viewport.
      const io = new IntersectionObserver((entries) => {
        for (const e of entries) if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
      }, { rootMargin: '0px 0px -10% 0px' });
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));

      // Card spotlight follows the cursor.
      document.addEventListener('pointermove', (e) => {
        const card = (e.target as HTMLElement).closest<HTMLElement>('.card');
        if (!card) return;
        const r = card.getBoundingClientRect();
        card.style.setProperty('--mx', `${e.clientX - r.left}px`);
        card.style.setProperty('--my', `${e.clientY - r.top}px`);
      }, { passive: true });

      // Accessible tabs (audience and code examples).
    document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((root) => {
      const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
      const select = (t: HTMLButtonElement) => {
        tabs.forEach((x) => {
          const on = x === t;
          x.setAttribute('aria-selected', String(on));
          x.tabIndex = on ? 0 : -1;
          document.getElementById(x.getAttribute('aria-controls')!)!.hidden = !on;
        });
      };
      tabs.forEach((t, i) => {
        t.addEventListener('click', () => select(t));
        t.addEventListener('keydown', (e) => {
          const d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
          if (!d) return;
          const n = tabs[(i + d + tabs.length) % tabs.length];
          n.focus(); select(n); e.preventDefault();
        });
      });
    });

      // Copy buttons.
      document.addEventListener('click', async (e) => {
        const b = (e.target as HTMLElement).closest<HTMLElement>('[data-copy]');
        if (!b) return;
        try {
          await navigator.clipboard.writeText(b.dataset.copy || '');
          b.classList.add('copied');
          setTimeout(() => b.classList.remove('copied'), 1400);
        } catch { /* clipboard unavailable */ }
      });
    </script>

    <style>
      .skip:focus { position: fixed; top: 12px; left: 12px; width: auto; height: auto; clip: auto; z-index: 100; background: var(--mint-400); color: var(--on-mint); padding: 8px 14px; border-radius: 8px; }
      .nav { position: sticky; top: 0; z-index: 50; transition: background 240ms ease, border-color 240ms ease, backdrop-filter 240ms ease; border-bottom: 1px solid transparent; }
      .nav.scrolled { background: rgba(8, 11, 16, 0.72); backdrop-filter: saturate(160%) blur(16px); -webkit-backdrop-filter: saturate(160%) blur(16px); border-bottom-color: var(--line-1); }
      .nav-inner { height: 68px; display: flex; align-items: center; gap: 28px; }
      .brand { flex: none; }
      .links { display: flex; gap: 4px; margin-left: 12px; }
      .links a { font-size: 14.5px; color: var(--fg-2); padding: 8px 12px; border-radius: 999px; transition: color 150ms ease, background 150ms ease; }
      .links a:hover { color: var(--fg-1); background: rgba(255, 255, 255, 0.05); }
      .actions { margin-left: auto; display: flex; align-items: center; gap: 10px; }
      .gh { color: var(--fg-2); padding: 8px; border-radius: 999px; transition: color 150ms ease; }
      .gh:hover { color: var(--fg-1); }
      .menu { display: none; width: 40px; height: 40px; background: transparent; border: 1px solid var(--line-2); border-radius: 999px; position: relative; cursor: pointer; }
      .menu span { position: absolute; left: 12px; right: 12px; height: 1.5px; background: var(--fg-1); transition: transform 200ms ease; }
      .menu span:first-child { top: 16px; } .menu span:last-child { top: 22px; }
      .menu[aria-expanded='true'] span:first-child { transform: translateY(3px) rotate(45deg); }
      .menu[aria-expanded='true'] span:last-child { transform: translateY(-3px) rotate(-45deg); }
      .drawer[hidden] { display: none; }
      .drawer { display: grid; padding: 8px 24px 20px; background: rgba(8, 11, 16, 0.96); border-bottom: 1px solid var(--line-1); }
      .drawer a { padding: 12px 0; border-bottom: 1px solid var(--line-1); color: var(--fg-2); }
      @media (max-width: 900px) { .links, .hide-sm { display: none; } .menu { display: block; } }
      @media (min-width: 901px) { .drawer { display: none !important; } }

      .footer { border-top: 1px solid var(--line-1); padding: 72px 0 28px; background: linear-gradient(180deg, transparent, rgba(62, 232, 181, 0.025)); }
      .foot-grid { display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 40px; }
      .foot-grid h4 { margin: 4px 0 14px; font-size: 13px; font-weight: 600; color: var(--fg-1); letter-spacing: 0.01em; }
      .foot-grid a { display: block; color: var(--fg-3); font-size: 14.5px; padding: 4px 0; transition: color 150ms ease; }
      .foot-grid a:hover { color: var(--fg-1); }
      .foot-brand p { max-width: 300px; font-size: 14.5px; margin: 16px 0; }
      .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--mint-400); box-shadow: 0 0 10px var(--mint-400); }
      .foot-base { display: flex; justify-content: space-between; gap: 16px; margin-top: 56px; padding-top: 22px; border-top: 1px solid var(--line-1); font-size: 13.5px; color: var(--fg-3); }
      @media (max-width: 760px) { .foot-grid { grid-template-columns: 1fr 1fr; } .foot-brand { grid-column: 1 / -1; } .foot-base { flex-direction: column; } }
    </style>
  </body>
</html>
