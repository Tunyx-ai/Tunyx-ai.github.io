---
import { SITE, url, pilotHref } from '../../site.config';

const steps = [
  { c: SITE.install, n: 'Install' },
  { c: 'pip install vllm', n: 'Add an engine' },
  { c: 'tunyx up qwen2.5:7b', n: 'Deploy' },
];
const faq = [
  ['Is Tunyx another inference engine?', `No, it's a control plane. It runs proven engines (vLLM, SGLang, llama.cpp, MLX), decides how to run them for your workload, proves the result, and operates them. See <a href="${url('docs/concepts/comparison/')}">how it compares</a> with Ollama, raw vLLM, NIM and managed APIs.`],
  ['What hardware and models does it support?', 'NVIDIA GPUs (including MIG slices and machines with 1–8 GPUs), AMD via ROCm, Apple Silicon and CPU servers. Any model your engine supports: Hugging Face repos, local checkpoints, GGUF files and LoRA adapters.'],
  ['Does any data leave my machines?', 'No. Tunyx runs entirely on your infrastructure and works air-gapped. There is no phone-home.'],
  ['Can I try it without a GPU?', 'Yes. `tunyx demo` runs the whole product on a simulated H100 in about a minute, including a quality gate rejecting a broken quantized build.'],
  ['Does it support multiple machines?', 'Today Tunyx manages one node with up to 8 GPUs, where most self-hosted inference runs. Multi-node fleets and replica autoscaling are on the roadmap.'],
  ['What does it cost?', `Tunyx is in ${SITE.status.toLowerCase()}. Pilots are free in exchange for feedback.`],
];
---
<section class="section" id="faq">
  <div class="container faq-wrap">
    <div class="reveal">
      <span class="eyebrow">FAQ</span>
      <h2 class="h-section">Questions, answered.</h2>
      <p class="lede">Something else? <a class="lnk" href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
    </div>
    <div class="faq reveal">
      {faq.map(([q, a]) => (
        <details>
          <summary>{q}<span class="pm" aria-hidden="true"></span></summary>
          <p set:html={a.replace(/`([^`]+)`/g, '<code>$1</code>')} />
        </details>
      ))}
    </div>
  </div>
</section>

<section class="final" id="quickstart">
  <div class="container">
    <div class="final-card reveal">
      <div class="final-glow" aria-hidden="true"></div>
      <h2 class="h-section">Stop tuning. Start shipping.</h2>
      <p class="lede">Three commands to a tuned endpoint. Join the private beta and we’ll help you deploy your first model.</p>
      <ol class="cmds">
        {steps.map((s, i) => (
          <li class="cmd">
            <span class="num">{i + 1}</span>
            <span class="n">{s.n}</span>
            <code><span class="tok-prompt">$ </span>{s.c}</code>
            <button class="cp" data-copy={s.c} aria-label={`Copy: ${s.c}`}>
              <svg class="i-copy" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="12" height="12" rx="2"/><path d="M5 15V5a2 2 0 0 1 2-2h10"/></svg>
              <svg class="i-ok" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M20 6 9 17l-5-5"/></svg>
            </button>
          </li>
        ))}
      </ol>
      <div class="final-cta">
        <a class="btn btn-primary" href={pilotHref}>Request a pilot <span class="arrow">→</span></a>
        <a class="btn btn-ghost" href={url('docs/getting-started/quickstart/')}>Read the quickstart</a>
      </div>
    </div>
  </div>
</section>

<style>
  .faq-wrap { display: grid; grid-template-columns: 0.8fr 1.2fr; gap: clamp(32px, 5vw, 72px); align-items: start; }
  .lede { margin-top: 18px; }
  .lnk { color: var(--mint-400); border-bottom: 1px solid rgba(62, 232, 181, 0.35); }
  .faq { display: grid; border-top: 1px solid var(--line-1); }
  details { border-bottom: 1px solid var(--line-1); }
  summary { list-style: none; cursor: pointer; padding: 19px 0; font-size: 16.5px; font-weight: 550; letter-spacing: -0.01em; display: flex; justify-content: space-between; gap: 20px; align-items: center; }
  summary::-webkit-details-marker { display: none; }
  summary:hover { color: #fff; }
  .pm { position: relative; flex: none; width: 14px; height: 14px; }
  .pm::before, .pm::after { content: ''; position: absolute; left: 0; right: 0; top: 6px; height: 2px; border-radius: 2px; background: var(--fg-3); transition: transform 240ms var(--ease-out); }
  .pm::after { transform: rotate(90deg); }
  details[open] .pm::after { transform: rotate(0); }
  details p { margin: -6px 0 20px; color: var(--fg-2); font-size: 15px; line-height: 1.65; max-width: 640px; }
  details p :global(code) { font-size: 0.88em; background: rgba(255, 255, 255, 0.05); padding: 1px 6px; border-radius: 5px; border: 1px solid var(--line-1); }
  details p :global(a) { color: var(--mint-400); border-bottom: 1px solid rgba(62, 232, 181, 0.35); }

  .final { padding: 24px 0 clamp(72px, 9vw, 120px); }
  .final-card { position: relative; overflow: hidden; text-align: center; padding: clamp(44px, 7vw, 80px) 24px; border-radius: var(--radius-xl); border: 1px solid var(--line-2); background: linear-gradient(180deg, rgba(17, 22, 30, 0.9), rgba(8, 11, 16, 0.9)); }
  .final-glow { position: absolute; inset: auto 0 -60% 0; height: 120%; background: radial-gradient(50% 50% at 50% 50%, rgba(62, 232, 181, 0.22), rgba(56, 189, 248, 0.08) 45%, transparent 70%); pointer-events: none; }
  .final-card > :not(.final-glow) { position: relative; }
  .final-card .lede { margin-inline: auto; }
  .cmds { list-style: none; padding: 0; margin: 32px auto 0; max-width: 680px; display: grid; gap: 8px; text-align: left; }
  .cmd { display: grid; grid-template-columns: auto 104px 1fr auto; align-items: center; gap: 14px; padding: 10px 10px 10px 14px; border-radius: 12px; border: 1px solid var(--line-1); background: rgba(5, 7, 10, 0.6); }
  .num { width: 24px; height: 24px; border-radius: 7px; display: grid; place-items: center; font-family: var(--font-mono); font-size: 12px; color: var(--mint-400); border: 1px solid rgba(62, 232, 181, 0.35); }
  .n { font-size: 13px; color: var(--fg-3); }
  .cmd code { font-size: 13.5px; color: var(--fg-1); overflow-x: auto; white-space: nowrap; }
  .cp { width: 30px; height: 30px; border-radius: 8px; border: 1px solid var(--line-2); background: transparent; color: var(--fg-3); display: grid; place-items: center; cursor: pointer; }
  .cp:hover { color: var(--fg-1); border-color: var(--line-3); }
  .cp .i-ok { display: none; color: var(--mint-400); }
  .cp:global(.copied) .i-copy { display: none; }
  .cp:global(.copied) .i-ok { display: block; }
  .final-cta { display: flex; gap: 12px; justify-content: center; margin-top: 30px; flex-wrap: wrap; }
  @media (max-width: 900px) { .faq-wrap { grid-template-columns: 1fr; } }
  @media (max-width: 560px) { .cmd { grid-template-columns: auto 1fr auto; } .n { display: none; } }
</style>
