---
const items = [
  ['On your hardware', 'Your GPUs, your cloud or air-gapped. Prompts never leave.'],
  ['Scoped keys & limits', 'Per-team keys, deployment scopes, rate and token limits.'],
  ['Roles', 'Admin, inference and read-only viewer keys.'],
  ['Audit log', 'Hash-chained and verifiable; streams to your SIEM.'],
  ['Four-eyes changes', 'Optionally require a second admin to approve.'],
  ['Policy & TLS', 'Model allow-lists, no remote code, TLS and mutual TLS.'],
];
---
<section class="section sec-wrap" id="security">
  <div class="container">
    <div class="card sec reveal">
      <div class="head">
        <span class="eyebrow">Enterprise-ready</span>
        <h2>Your models. Your hardware. Your rules.</h2>
      </div>
      <ul class="grid">
        {items.map(([h, b]) => (
          <li>
            <span class="ic" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6 9 17l-5-5"/></svg></span>
            <div><h3>{h}</h3><p>{b}</p></div>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .sec-wrap { padding-block: clamp(56px, 7vw, 88px); }
  .sec { padding: clamp(24px, 3.5vw, 40px); background: radial-gradient(600px 260px at 0% 0%, rgba(62, 232, 181, 0.08), transparent 70%), linear-gradient(180deg, rgba(255, 255, 255, 0.03), rgba(255, 255, 255, 0.01)); }
  .head { display: flex; flex-direction: column; gap: 10px; margin-bottom: 26px; }
  h2 { margin: 0; font-size: clamp(24px, 2.6vw, 32px); letter-spacing: -0.035em; font-weight: 620; }
  .grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px 28px; }
  li { display: flex; gap: 12px; align-items: flex-start; }
  .ic { flex: none; width: 24px; height: 24px; border-radius: 7px; display: grid; place-items: center; color: var(--mint-400); background: rgba(62, 232, 181, 0.1); margin-top: 1px; }
  h3 { margin: 0 0 3px; font-size: 15px; font-weight: 600; letter-spacing: -0.01em; }
  p { margin: 0; font-size: 13.8px; color: var(--fg-2); line-height: 1.55; }
  @media (max-width: 900px) { .grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .grid { grid-template-columns: 1fr; } }
</style>
