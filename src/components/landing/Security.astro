---
const items = [
  ['Runs where your data lives', 'Your GPUs, your cloud account or fully air-gapped. Prompts and outputs never leave your network.'],
  ['Scoped keys and limits', 'Named API keys per team, deployment scopes, requests-per-minute, tokens-per-minute and concurrency limits.'],
  ['Roles', 'Separate admin, inference and read-only viewer keys for the dashboard and metrics.'],
  ['Tamper-evident audit log', 'Every change and denied access is hash-chained and verifiable, and can stream to your SIEM.'],
  ['Four-eyes changes', 'Optionally require a second admin to approve every deployment change.'],
  ['Policy guardrails', 'Allow-list models, refuse remote code or pickle weights, pin revisions, cap GPU share and max tokens. TLS and mutual TLS built in.'],
];
---
<section class="section" id="security">
  <div class="container">
    <div class="sec card reveal">
      <div class="left">
        <span class="eyebrow">Enterprise-ready</span>
        <h2 class="h-section">Your models. Your hardware. Your rules.</h2>
        <p class="lede">Built for teams that chose self-hosting for privacy, compliance and control, with the governance to match.</p>
      </div>
      <div class="grid">
        {items.map(([h, b]) => (
          <div class="it">
            <h3>{h}</h3>
            <p>{b}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .sec { display: grid; grid-template-columns: 0.85fr 1.15fr; gap: clamp(28px, 4vw, 56px); padding: clamp(28px, 4.5vw, 56px); background: radial-gradient(600px 300px at 0% 0%, rgba(62, 232, 181, 0.08), transparent 70%), linear-gradient(180deg, rgba(255, 255, 255, 0.03), rgba(255, 255, 255, 0.01)); }
  .lede { margin-top: 18px; }
  .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1px; background: var(--line-1); border-radius: 14px; overflow: hidden; border: 1px solid var(--line-1); }
  .it { padding: 20px; background: var(--ink-2); }
  h3 { margin: 0 0 6px; font-size: 15.5px; font-weight: 600; letter-spacing: -0.01em; }
  p { margin: 0; font-size: 14px; color: var(--fg-2); line-height: 1.6; }
  @media (max-width: 960px) { .sec { grid-template-columns: 1fr; } }
  @media (max-width: 560px) { .grid { grid-template-columns: 1fr; } }
</style>
