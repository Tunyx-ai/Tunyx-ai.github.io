---
const steps = [
  { k: 'Plan', title: 'Reads hardware and model', body: 'Picks engine, precision, context and layout for your GPUs, and explains why.', cmd: 'tunyx plan' },
  { k: 'Serve', title: 'Live in one model load', body: 'The safest config that fits serves as soon as it passes its checks.', cmd: 'tunyx up' },
  { k: 'Optimize', title: 'Measures real candidates', body: 'Benchmarks faster configs against your workload in the background.', cmd: '-O standard' },
  { k: 'Validate', title: 'Promotes only what passes', body: 'Latency targets and the quality gate, or it keeps the safe config and tells you why.', cmd: 'quality gate' },
  { k: 'Operate', title: 'Keeps it healthy', body: 'Self-heals, sleeps idle models, canaries changes and retunes from traffic.', cmd: 'tunyx status' },
];
---
<section class="section" id="how">
  <div class="container">
    <div class="section-head center reveal">
      <span class="eyebrow">How it works</span>
      <h2 class="h-section">One closed loop, from model to healthy endpoint.</h2>
      <p class="lede">The expert work of a senior inference engineer, automated, and repeated as your traffic changes.</p>
    </div>

    <ol class="loop">
      {steps.map((s, i) => (
        <li class="step reveal" style={`transition-delay:${i * 90}ms`}>
          <div class="node"><span>{i + 1}</span></div>
          <div class="card body">
            <div class="top">
              <span class="k">{s.k}</span>
              <code>{s.cmd}</code>
            </div>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .loop { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(5, 1fr); gap: 14px; position: relative; }
  .loop::before {
    content: ''; position: absolute; top: 19px; left: 10%; right: 10%; height: 1px;
    background: linear-gradient(90deg, transparent, var(--mint-400), var(--sky-400), transparent); opacity: 0.5;
  }
  .step { display: flex; flex-direction: column; align-items: center; gap: 18px; }
  .node {
    position: relative; width: 40px; height: 40px; border-radius: 12px; display: grid; place-items: center;
    background: var(--ink-3); border: 1px solid rgba(62, 232, 181, 0.4); color: var(--mint-400);
    font-family: var(--font-mono); font-size: 14px; font-weight: 600;
    box-shadow: 0 0 24px -4px rgba(62, 232, 181, 0.45);
  }
  .body { padding: 18px 18px 20px; width: 100%; height: 100%; }
  .top { display: flex; justify-content: space-between; align-items: center; gap: 8px; }
  .k { font-size: 12px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--mint-400); }
  code { font-size: 11.5px; color: var(--fg-3); background: rgba(255, 255, 255, 0.04); padding: 2px 7px; border-radius: 6px; border: 1px solid var(--line-1); white-space: nowrap; }
  h3 { margin: 18px 0 8px; font-size: 17px; letter-spacing: -0.02em; font-weight: 600; line-height: 1.3; }
  p { margin: 0; color: var(--fg-2); font-size: 14.2px; line-height: 1.6; }
  @media (max-width: 1080px) {
    .loop { grid-template-columns: 1fr; max-width: 640px; margin-inline: auto; }
    .loop::before { top: 20px; bottom: 20px; left: 19px; right: auto; width: 1px; height: auto; background: linear-gradient(180deg, var(--mint-400), var(--sky-400)); }
    .step { flex-direction: row; align-items: flex-start; }
    .node { flex: none; }
  }
</style>
