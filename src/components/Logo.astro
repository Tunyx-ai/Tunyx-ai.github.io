---
// The mark is a damped wave settling to a flat line: a system being tuned until it holds steady.
interface Props { size?: number; wordmark?: boolean }
const { size = 28, wordmark = true } = Astro.props;
const id = `lg-${Math.random().toString(36).slice(2, 8)}`;
---
<span class="logo" aria-label="Tunyx">
  <svg width={size} height={size} viewBox="0 0 32 32" fill="none" aria-hidden="true">
    <defs>
      <linearGradient id={id} x1="4" y1="8" x2="28" y2="24" gradientUnits="userSpaceOnUse">
        <stop stop-color="#3EE8B5" />
        <stop offset="1" stop-color="#38BDF8" />
      </linearGradient>
    </defs>
    <rect width="32" height="32" rx="8" fill="#0B0F15" />
    <rect x=".5" y=".5" width="31" height="31" rx="7.5" stroke="#fff" stroke-opacity=".12" />
    <path d="M5 16c1.6-9 3.4-9 5 0s3.2 7 4.6 0 2.8-4.6 4 0 2.4 2.6 3.4 0 2-1.2 2.8 0 1.4.4 2.2 0"
      stroke={`url(#${id})`} stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
  {wordmark && <span class="word">tunyx</span>}
</span>

<style>
  .logo { display: inline-flex; align-items: center; gap: 10px; color: inherit; }
  .word { font-weight: 640; font-size: 19px; letter-spacing: -0.04em; line-height: 1; }
</style>
